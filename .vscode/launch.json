{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "JLink debug",
            /* Configuration for the STM32F303 Discovery board */
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceRoot}",
            "preLaunchTask": "cargo build debug",
            "runToEntryPoint": "main",
            "executable": "./target/thumbv7em-none-eabihf/debug/${workspaceFolderBasename}",
            "device": "EFM32PG1B200F256GM48",
            "svdFile": "${workspaceRoot}/EFM32PG1B.svd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 8000000,
                "swoFrequency": 2000000,
                "source": "probe",
                "decoders": [
                    {
                        "type": "console",
                        "label": "ITM",
                        "port": 0
                    }
                ]
            }
        },
        {
            "name": "probe_rs debug",
            "preLaunchTask": "cargo build debug",
            "type": "probe-rs-debug",
            "request": "launch",
            "flashingConfig": {
                "flashingEnabled": true,
                "verifyBeforeFlashing": true,
                "verifyAfterFlashing": true,
                "haltAfterReset": true
            },
            "chip": "EFM32PG1B200F256GM48",
            "coreConfigs": [
                {
                    "programBinary": "./target/thumbv7em-none-eabihf/debug/${workspaceFolderBasename}",
                    "svdFile": "EFM32PG1B.svd",
                    "rttEnabled": true,
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            // Format RTT data as String data
                            "dataFormat": "Defmt",
                            // Include host-side timestamps for every line of data transferred from the target RTT output
                            "showTimestamps": true,
                            "showLocation": true,
                            "logFormat": "{{t}%italic%dimmed} {L:severity:italic} {s}    {{ff}:{l}%italic%dimmed}"
                        }
                    ]
                }
            ],
        },
    ]
}